# === REQUIRED ===

# Telegram Bot Token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID — get from @userinfobot on Telegram
# This restricts the bot to respond ONLY to you
TELEGRAM_USER_ID=your_telegram_user_id_here

# OpenCode Zen API Key — get from https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here

# NewsAPI Key — get from https://newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# === OPTIONAL ===

# AI model (default: muse-spark-1.3-contributor-free, free tier on OpenCode Zen)
FAST_MODEL=muse-spark-1.3-contributor-free
DEEP_MODEL=muse-spark-1.3-contributor-free

# Model API endpoint (default: https://opencode.ai/zen/v1)
# MODEL_API_URL=https://opencode.ai/zen/v1

# === OPTIONAL (Phase 1 model pool — failover) ===
# Setting any of these adds that provider to the model pool. Models without a
# key are skipped automatically. Google/Groq free tiers are generous; the pool
# falls back across providers when the priority-0 model is rate-limited.

# Google AI Studio — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_google_ai_studio_key_here

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here

# OpenRouter (optional backstop) — https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=your_openrouter_key_here

# GitHub PAT (GitHub Models backstop) — https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_pat_here

# Full registry override (YAML or JSON). See agent/registry.py for the schema.
# MODELS_FILE=/path/to/models.yaml

# Per-request provider timeout in seconds (default: 60)
# PROVIDER_TIMEOUT=60

# Timezone (default: Asia/Jakarta = UTC+7)
TIMEZONE=Asia/Jakarta

# Morning news delivery time (24h format, default: 06:00)
NEWS_DELIVERY_HOUR=6
NEWS_DELIVERY_MINUTE=0

# Daily agenda delivery time (24h format, default: 06:30)
AGENDA_DELIVERY_HOUR=6
AGENDA_DELIVERY_MINUTE=30

# Database path (default: ./data/second_brain.db)
DATABASE_PATH=./data/second_brain.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
